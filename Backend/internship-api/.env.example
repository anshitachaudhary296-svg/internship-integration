# ============================================================
# Environment Configuration - Example Template
# Copy this file to .env and configure your local settings
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Relative or absolute path to SQLite file)
DB_PATH=./database/internships.db

# CORS Configuration (comma-separated list of origins or * for all)
CORS_ORIGIN=*

# Rate Limiting Configuration
# Global API Rate Limit (milliseconds and maximum requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Application Submission Rate Limit (prevent spamming applications)
SUBMIT_LIMIT_WINDOW_MS=900000
SUBMIT_LIMIT_MAX=20
